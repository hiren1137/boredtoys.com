---
import type { SpendData } from '../games/_spend/types';
import { formatLong, formatDate } from '../../scripts/lib/net-worth.mjs';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const modules = import.meta.glob<{ default: SpendData }>('../data/spend/*.ts', { eager: true });
const data = modules[`../data/spend/${slug}.ts`]?.default;
const LIST_URL = 'https://www.forbes.com/real-time-billionaires/';
---

{
  data && (
    <div class="worth-note">
      <p class="worth-line">
        As of <time datetime={data.asOf}>{formatDate(data.asOf)}</time>, Forbes reports {data.possessive} net worth at{' '}
        <strong>{formatLong(data.netWorth)}</strong> (US dollars).
      </p>
      <p class="worth-meta">
        Source:{' '}
        <a href={LIST_URL} target="_blank" rel="noopener">
          {data.sourceName}
        </a>
        <span aria-hidden="true">·</span>
        <a href={data.sourceUrl} target="_blank" rel="noopener">
          {data.person} on Forbes
        </a>
        <span class="worth-badge">
          <span class="worth-dot" aria-hidden="true" />
          Updated weekly
        </span>
      </p>
    </div>
  )
}

<style>
  .worth-note {
    margin: 4px 0 18px;
  }
  .worth-line {
    margin: 0 0 6px;
    font-size: 1.05rem;
  }
  .worth-line strong {
    font-family: var(--font-round);
    font-weight: 900;
  }
  .worth-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .worth-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 10px;
    border: 2px solid var(--line);
    border-radius: 999px;
    background: var(--mint);
    color: #1f1a2e;
    font-weight: 800;
    font-size: 0.8rem;
  }
  .worth-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #12804a;
    animation: worth-pulse 2s ease-in-out infinite;
  }
  @keyframes worth-pulse {
    50% {
      opacity: 0.35;
    }
  }
</style>
